{
  "expo": {
    "name": "Skyloom",
    "slug": "skyloom",
    "owner": "aryanali42605",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#070a1c",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.skyloom.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Skyloom uses your location to add the sky above you to your loom."
      }
    },
    "android": {
      "package": "com.skyloom.app",
      "adaptiveIcon": {
        "backgroundColor": "#070a1c",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070a1c",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#8f7bff"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Skyloom uses your location to add the sky above you to your loom."
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "0c8bb278-4cc8-433d-9fe2-bce6fe409007"
      }
    }
  }
}
